Intel GPU (PyTorch XPU) support for the GROMACS 2026.3 NNPot interface, plus a fix for the
"pairs-shifts" typo in nnpot.cpp (a model requesting only pair-shifts never got its pair list).

--- a/gromacs-2026.3/src/gromacs/applied_forces/nnpot/torchmodel.cpp
+++ b/gromacs-2026.3/src/gromacs/applied_forces/nnpot/torchmodel.cpp
@@ -41,6 +41,8 @@
 
 #include "torchmodel.h"
 
+#include <torch/xpu.h>
+
 #include <dlfcn.h>
 
 #include <iostream>
@@ -130,11 +132,39 @@
         GMX_THROW(InternalError("Could not get active device: hipGetDevice failed."));
     }
     return { "hip", activeDevice };
+#elif GMX_SYCL_DPCPP
+    // Intel GPUs: libtorch's XPU backend (PyTorch >= 2.5). mdrun's SYCL device and torch's XPU
+    // enumeration are both in Level Zero order; with one GPU per rank this is device 0.
+    if (torch::xpu::is_available())
+    {
+        return { "xpu", 0 };
+    }
+    return { "cpu", std::nullopt };
 #else
     return { "cpu", std::nullopt };
 #endif
 }
 
+//! \brief \internal torch device type for the string returned by getMdrunActiveDevice()
+static torch::DeviceType torchDeviceTypeFor(const std::string& type)
+{
+    if (type == "xpu")
+    {
+        return torch::kXPU;
+    }
+    return torch::kCUDA; // libtorch addresses ROCm/HIP devices as kCUDA
+}
+
+//! \brief \internal whether libtorch can see a GPU of the given type
+static bool torchGpuAvailable(const std::string& type)
+{
+    if (type == "xpu")
+    {
+        return torch::xpu::is_available();
+    }
+    return torch::cuda::is_available();
+}
