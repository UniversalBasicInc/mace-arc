integrator = md
nsteps = 10000
dt = 0.001
nstenergy = 100
nstcalcenergy = 100
nstlog = 1000
nstxout-compressed = 1000
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
gen-vel = yes
gen-temp = 300
gen-seed = 42
comm-mode = linear
nstcomm = 100
cutoff-scheme = Verlet
nstlist = 10
pbc = xyz
rlist = 0.7
coulombtype = cut-off
rcoulomb = 0.7
vdwtype = cut-off
rvdw = 0.7
nnpot-active = yes
nnpot-modelfile = /data/mace-arc/gmx/models/mace_mp_small_gmx.pt
nnpot-input-group = System
nnpot-model-input1 = atom-positions
nnpot-model-input2 = atom-numbers
nnpot-model-input3 = atom-pairs
nnpot-model-input4 = pair-shifts
nnpot-model-input5 = box
nnpot-model-input6 = pbc
nnpot-pair-cutoff = 0.6
