From ad89e096c7432d6f6e60a82966f53d34843b47ce Mon Sep 17 00:00:00 2001
From: Dylan Holdren <Dylan@UniversalBasicInc.com>
Date: Thu, 15 Oct 2026 20:17:49 -0400
Subject: [PATCH] Fix NNPot pair-list subscription for models requesting only
 pair-shifts

The checks that subscribe the NNPot module to the pair-list range and
pair-list construction notifications tested for the misspelled input name
"pairs-shifts". A model whose inputs include pair-shifts but not atom-pairs
was therefore never given a pair list. Use the option name "pair-shifts",
and add tests that each pair-list input requests the pair-list range.

Fixes #5753
---
 docs/release-notes/2026/2026.5.rst            | 11 +++
 src/gromacs/applied_forces/nnpot/nnpot.cpp    |  4 +-
 .../applied_forces/nnpot/tests/nnpot.cpp      | 89 +++++++++++++++++++
 3 files changed, 102 insertions(+), 2 deletions(-)

diff --git a/docs/release-notes/2026/2026.5.rst b/docs/release-notes/2026/2026.5.rst
index d70ded9..8bb69a5 100644
--- a/docs/release-notes/2026/2026.5.rst
+++ b/docs/release-notes/2026/2026.5.rst
@@ -50,6 +50,17 @@ This has been present in versions 2026.0 to 2026.4.
 
 :issue:`5736`
 
+Fixed NNPot pair-list input for models requesting only ``pair-shifts``
+""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
+
+A neural network potential model whose inputs include ``pair-shifts`` but not
+``atom-pairs`` was never subscribed to the pair-list construction, because the
+option name was misspelled in that check, so the model was passed an empty
+shift list without any error. Models that also request ``atom-pairs`` were not
+affected. This has been present in versions 2026.0 to 2026.4.
+
+:issue:`5753`
+
 Fixes for ``gmx`` tools
 ^^^^^^^^^^^^^^^^^^^^^^^
 
diff --git a/src/gromacs/applied_forces/nnpot/nnpot.cpp b/src/gromacs/applied_forces/nnpot/nnpot.cpp
index 34ff8ab..30107d2 100644
--- a/src/gromacs/applied_forces/nnpot/nnpot.cpp
+++ b/src/gromacs/applied_forces/nnpot/nnpot.cpp
@@ -177,7 +177,7 @@ public:
 
         // set pairlist range
         if (nnpotOptions_.parameters().modelNeedsInput("atom-pairs")
-            || nnpotOptions_.parameters().modelNeedsInput("pairs-shifts"))
+            || nnpotOptions_.parameters().modelNeedsInput("pair-shifts"))
         {
             const auto setPlainPairlistRangeFunction = [this](PlainPairlistRanges* plainPairlistRanges)
             { plainPairlistRanges->addRange(nnpotOptions_.parameters().pairCutoff_); };
@@ -207,7 +207,7 @@ public:
 
         // subscribe to pairlist construction notification
         if (nnpotOptions_.parameters().modelNeedsInput("atom-pairs")
-            || nnpotOptions_.parameters().modelNeedsInput("pairs-shifts"))
+            || nnpotOptions_.parameters().modelNeedsInput("pair-shifts"))
         {
             const auto notifyPairlistFunction = [this](const MDModulesPairlistConstructedSignal& signal)
             { nnpotForceProvider_->setPairlist(signal); };
diff --git a/src/gromacs/applied_forces/nnpot/tests/nnpot.cpp b/src/gromacs/applied_forces/nnpot/tests/nnpot.cpp
index a3d1bcf..4ff2f09 100644
--- a/src/gromacs/applied_forces/nnpot/tests/nnpot.cpp
+++ b/src/gromacs/applied_forces/nnpot/tests/nnpot.cpp
@@ -45,13 +45,16 @@
 #include <gtest/gtest.h>
 
 #include "gromacs/mdrunutility/mdmodulesnotifiers.h"
+#include "gromacs/mdrunutility/plainpairlistranges.h"
 #include "gromacs/mdtypes/forceoutput.h"
 #include "gromacs/mdtypes/iforceprovider.h"
 #include "gromacs/mdtypes/imdmodule.h"
 #include "gromacs/mdtypes/imdpoptionprovider.h"
 #include "gromacs/mdtypes/imdpoptionprovider_test_helper.h"
+#include "gromacs/mdtypes/inputrec.h"
 #include "gromacs/options/options.h"
 #include "gromacs/options/treesupport.h"
+#include "gromacs/topology/topology.h"
 #include "gromacs/utility/keyvaluetree.h"
 #include "gromacs/utility/keyvaluetreebuilder.h"
 #include "gromacs/utility/keyvaluetreetransform.h"
@@ -77,6 +80,38 @@ public:
         mdpValueBuilder_.rootObject().addValue("nnpot-active", std::string("true"));
     }
 
+    //! Request the given model inputs and a pair cutoff through the mdp options
+    void addMdpOptionModelInputs(const std::vector<std::string>& inputs, const std::string& pairCutoff)
+    {
+        for (size_t i = 0; i < inputs.size(); ++i)
+        {
+            const std::string key = "nnpot-model-input" + std::to_string(i + 1);
+            mdpValueBuilder_.rootObject().addValue(key, inputs[i]);
+        }
+        mdpValueBuilder_.rootObject().addValue("nnpot-pair-cutoff", pairCutoff);
+    }
+
+    //! Collect the pair-list range the module requests during simulation setup
+    std::vector<real> requestedPairlistRanges()
+    {
+        MDModulesNotifiers notifiers;
+        NNPotModule_->subscribeToSimulationSetupNotifications(&notifiers);
+        const gmx_mtop_t    mtop;
+        const t_inputrec    inputrec;
+        PlainPairlistRanges ranges(mtop, inputrec);
+        notifiers.simulationSetupNotifier_.notify(&ranges);
+        return { ranges.ranges().begin(), ranges.ranges().end() };
+    }
+
+    //! Whether the module subscribes to the pair-list construction signal during the run
+    bool subscribesToPairlistConstruction()
+    {
+        MDModulesNotifiers notifiers;
+        NNPotModule_->subscribeToSimulationRunNotifications(&notifiers);
+        using Signal = const MDModulesPairlistConstructedSignal&;
+        return notifiers.simulationRunNotifier_.haveSubscribers<Signal>();
+    }
+
     //! build an mdp options tree that sets the options for the NNPot module
     void makeNNPotModuleWithSetOptions()
     {
@@ -104,6 +139,60 @@ protected:
     MpiComm                    mpiComm_{ MpiComm::SingleRank{} };
 };
 
+//! A model that takes the pair list requests a pair-list range equal to the cutoff
+TEST_F(NNPotTest, AtomPairsInputRequestsPairlistRange)
+{
+    addMdpOptionNNPotActive();
+    addMdpOptionModelInputs({ "atom-positions", "atom-numbers", "atom-pairs" }, "0.5");
+    makeNNPotModuleWithSetOptions();
+
+    const std::vector<real> ranges = requestedPairlistRanges();
+    ASSERT_EQ(ranges.size(), 1U);
+    EXPECT_FLOAT_EQ(ranges[0], 0.5);
+}
+
+//! A model that takes only the periodic pair shifts needs the pair list just as much
+TEST_F(NNPotTest, PairShiftsInputRequestsPairlistRange)
+{
+    addMdpOptionNNPotActive();
+    addMdpOptionModelInputs({ "atom-positions", "atom-numbers", "pair-shifts" }, "0.5");
+    makeNNPotModuleWithSetOptions();
+
+    const std::vector<real> ranges = requestedPairlistRanges();
+    ASSERT_EQ(ranges.size(), 1U);
+    EXPECT_FLOAT_EQ(ranges[0], 0.5);
+}
+
+//! Without pair-list inputs no range is requested
+TEST_F(NNPotTest, NoPairlistInputRequestsNoRange)
+{
+    addMdpOptionNNPotActive();
+    addMdpOptionModelInputs({ "atom-positions", "atom-numbers" }, "0.5");
+    makeNNPotModuleWithSetOptions();
+
+    EXPECT_TRUE(requestedPairlistRanges().empty());
+}
+
+//! A model that takes only the periodic pair shifts is told when the pair list is built
+TEST_F(NNPotTest, PairShiftsInputSubscribesToPairlistConstruction)
+{
+    addMdpOptionNNPotActive();
+    addMdpOptionModelInputs({ "atom-positions", "atom-numbers", "pair-shifts" }, "0.5");
+    makeNNPotModuleWithSetOptions();
+
+    EXPECT_TRUE(subscribesToPairlistConstruction());
+}
+
+//! Without pair-list inputs the module does not ask to be told about the pair list
+TEST_F(NNPotTest, NoPairlistInputDoesNotSubscribeToPairlistConstruction)
+{
+    addMdpOptionNNPotActive();
+    addMdpOptionModelInputs({ "atom-positions", "atom-numbers" }, "0.5");
+    makeNNPotModuleWithSetOptions();
+
+    EXPECT_FALSE(subscribesToPairlistConstruction());
+}
+
 TEST_F(NNPotTest, ForceProviderLackingInputThrows)
 {
     // Prepare MDP inputs
